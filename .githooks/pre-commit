#!/usr/bin/env bash
# Refuses a commit whose STAGED Rust content is not what `cargo fmt` would
# write, whose staged .rs files break the file-size budget
# (scripts/file-size.py), or whose staged panic-sites.allow or purity.toml
# loosens against HEAD (scripts/panic-sites.py, scripts/purity.py). Checks the
# index blobs, not the worktree, so a formatted worktree cannot vouch for an
# unformatted stage. Installed by `just hooks`.
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
rc=0
bad=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # On stdin rustfmt --check exits 0 either way; a diff shows only as output.
  out="$(git show ":$f" | rustfmt --check --color never --config-path "$top/rustfmt.toml" 2>&1)" \
    || true
  [ -z "$out" ] || bad+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
if [ "${#bad[@]}" -gt 0 ]; then
  echo "pre-commit: staged Rust is not rustfmt-clean:" >&2
  printf '  %s\n' "${bad[@]}" >&2
  echo "run \`cargo fmt --all\` and stage again (or commit --no-verify)." >&2
  rc=1
fi
"$top/scripts/file-size.py" -C "$top" --staged || rc=1
"$top/scripts/panic-sites.py" -C "$top" --staged || rc=1
"$top/scripts/purity.py" -C "$top" --staged || rc=1
exit "$rc"
