<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  UAC basic call with a hold: INVITE, the final, ACK, hold, BYE. Every exit
  writes one call-outcome.v1 record with the `<log>` action (one JSON line in
  the -log_file); the record states what the caller saw and never judges it.

  -inf: field0 the R-URI user part, field1..field4 one header line each (an
        empty field leaves no line), rendered from the treatment catalog.
  -key: run, stream, shape (record labels); setup_ms (the setup deadline:
        no final by then is `ending: timeout`); hold_ms (the hold from the ACK).
  -cid_str and the From tag carry the run id, so two runs never share one.

  Exits and their record: a 2xx and a BYE answered 2xx (`answered`), a non-2xx
  final (`rejected`, ACKed), no final by setup_ms (`timeout`), a BYE answered
  481 or a BYE from the far end mid-call (`cut`), a BYE with no final
  (`stranded`), a request the scenario cannot serve (`failed`, the dialog torn
  down first when answered). A non-2xx final for the INVITE after its 2xx
  changes no ending: it is a protocol failure and the call goes on to its BYE.

  After the setup deadline the INVITE is not abandoned (RFC 3261 section 9.1):
  with a provisional it is CANCELed and its final awaited 64*T1; without one,
  responses are awaited until Timer B (64*T1 from the INVITE) and a late
  provisional is CANCELed. A non-2xx final is ACKed, a 2xx is ACKed and its
  dialog torn down; the record keeps the timeout. Every 2xx retransmission
  after the answer is ACKed again (section 13.2.2.4): a byte-identical copy by
  SIPp itself (it re-sends the ACK it sent after the 2xx), any other by the
  handler.

  SIPp runs a call one step per loop turn and reads its socket in between: a
  message landing while the call stands on a nop or a send goes to
  `_unexp.main`, and a copy byte-identical to the message last received is
  discarded there, so a response the handler drops is never seen again. The
  handler therefore acts on every response as the step it missed would have
  (GenericCounter2 counts them): a provisional stamps first_provisional, an
  INVITE 2xx is answered or ACKed again, an INVITE non-2xx final is rejected
  or ACKed; a response to another request is let go. The resume jumps to the
  step the call stood on, and SIPp then applies the `next` of the step before
  it: every label whose preceding step branches is guarded by an unreachable
  `<nop/>`. An optional recv always names its `next`: without one, SIPp leaves
  the call on the following recv, which may have no timeout.

  The first provisional is stamped arithmetically (fp_ms keeps its first
  value: fp_ms*fp_flag + now*(1-fp_flag)), since an action list has no
  condition. The INVITE is message 1 of the scenario: the ACK of a non-2xx
  and the CANCEL take its branch, z9hG4bK-[pid]-[call_number]-1.
-->
<scenario name="hakit UAC basic hold with call-outcome records">

  <nop>
    <action>
      <assignstr assign_to="r_se" value="null"/>
      <assignstr assign_to="r_ans" value="null"/>
      <assignstr assign_to="r_code" value="null"/>
      <assignstr assign_to="r_reason" value="null"/>
      <assignstr assign_to="r_fail" value=""/>
      <assignstr assign_to="r_sep" value=""/>
      <assignstr assign_to="r_ending" value="failed"/>
      <assignstr assign_to="r_verdict" value="unknown"/>
      <assign assign_to="em_acc" value="0"/>
      <assign assign_to="fp_flag" value="0"/>
      <assign assign_to="fp_ms" value="0"/>
      <assignstr assign_to="setup_str" value="[setup_ms]"/>
      <todouble assign_to="setup_ms" variable="setup_str"/>
      <assignstr assign_to="hold_str" value="[hold_ms]"/>
      <todouble assign_to="hold_ms" variable="hold_str"/>
      <gettimeofday assign_to="t_start,t_start_us"/>
      <multiply assign_to="t_start" value="1000"/>
      <divide assign_to="t_start_us" value="1000"/>
      <add assign_to="t_start" variable="t_start_us"/>
    </action>
  </nop>

  <send retrans="500" ontimeout="inv_timer_b" next="wait">
    <![CDATA[
      INVITE sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:caller@[local_ip]:[local_port]>
      Max-Forwards: 70
      [field1]
      [field2]
      [field3]
      [field4]
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=caller 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <!-- Setup: wait in 1 s steps for the final, until setup_ms. -->
  <nop/>
  <label id="tick"/>
  <nop test="setup_over" next="setup_timeout">
    <action>
      <gettimeofday assign_to="el_s,el_us"/>
      <multiply assign_to="el_s" value="1000"/>
      <divide assign_to="el_us" value="1000"/>
      <add assign_to="el_s" variable="el_us"/>
      <subtract assign_to="el_s" variable="t_start"/>
      <test assign_to="setup_over" variable="el_s" compare="greater_than_equal" variable2="setup_ms"/>
    </action>
  </nop>
  <label id="wait"/>
  <recv response="^1[0-9][0-9]$" regexp_match="true" optional="true" timeout="1000" ontimeout="tick" next="tick">
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assign assign_to="fp_take" value="1"/>
      <subtract assign_to="fp_take" variable="fp_flag"/>
      <multiply assign_to="fp_ms" variable="fp_flag"/>
      <multiply assign_to="now_s" variable="fp_take"/>
      <add assign_to="fp_ms" variable="now_s"/>
      <assign assign_to="fp_flag" value="1"/>
      <test assign_to="fp_seen" variable="fp_flag" compare="equal" value="1"/>
      <ereg regexp="m=" search_in="body" assign_to="em_m"/>
      <strcmp assign_to="em_c" variable="em_m" value=""/>
      <multiply assign_to="em_c" variable="em_c"/>
      <add assign_to="em_acc" variable="em_c"/>
    </action>
  </recv>
  <recv response="^2[0-9][0-9]$" regexp_match="true" optional="true" rrs="true" next="got_answer">
    <action>
      <ereg regexp="SIP/2\.0 ([0-9]+)" search_in="msg" assign_to="fin_all,fin_code"/>
    </action>
  </recv>
  <recv response="^[3-6][0-9][0-9]$" regexp_match="true" next="got_reject">
    <action>
      <ereg regexp="SIP/2\.0 ([0-9]+)" search_in="msg" assign_to="fin_all,fin_code"/>
      <ereg regexp="^[[:blank:]]*([A-Za-z0-9.+-]+)[[:blank:]]*;[^,]*cause[[:blank:]]*=[[:blank:]]*([0-9]+)" search_in="hdr" header="Reason:" assign_to="rsn_all,rsn_proto,rsn_cause"/>
    </action>
  </recv>

  <!-- A non-2xx final: ACK it on the INVITE's branch; the record keys it by
       the first value of its Reason (`<protocol>;cause=<n>`), else by the code. -->
  <nop/>
  <label id="got_reject"/>
  <send>
    <![CDATA[
      ACK sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-1;rport
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assignstr assign_to="r_se" value="[$now_s]"/>
      <assignstr assign_to="r_code" value="[$fin_code]"/>
      <assignstr assign_to="r_reason" value="&quot;[$fin_code]&quot;"/>
      <assignstr assign_to="r_ending" value="rejected"/>
      <assignstr assign_to="r_verdict" value="rejected"/>
    </action>
  </send>
  <nop condexec="rsn_all" next="write_record">
    <action>
      <assignstr assign_to="r_reason" value="&quot;[$rsn_proto];cause=[$rsn_cause]&quot;"/>
    </action>
  </nop>
  <nop next="write_record"/>

  <!-- The setup deadline passed (or the INVITE's retransmissions ran out). -->
  <nop/>
  <label id="inv_timer_b"/>
  <nop test="keep_ending" next="write_record"/>
  <label id="setup_timeout"/>
  <nop test="fp_seen" next="cancel">
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assignstr assign_to="r_se" value="[$now_s]"/>
      <assignstr assign_to="r_reason" value="&quot;timeout&quot;"/>
      <assignstr assign_to="r_ending" value="timeout"/>
      <assignstr assign_to="r_verdict" value="setup_timeout"/>
      <assign assign_to="keep_ending" value="1"/>
    </action>
  </nop>

  <!-- No provisional yet: no CANCEL (RFC 3261 section 9.1); wait until Timer B. -->
  <label id="late_tick"/>
  <nop test="late_over" next="write_record">
    <action>
      <gettimeofday assign_to="el_s,el_us"/>
      <multiply assign_to="el_s" value="1000"/>
      <divide assign_to="el_us" value="1000"/>
      <add assign_to="el_s" variable="el_us"/>
      <subtract assign_to="el_s" variable="t_start"/>
      <test assign_to="late_over" variable="el_s" compare="greater_than_equal" value="32000"/>
    </action>
  </nop>
  <nop test="fp_seen" next="cancel"/>
  <recv response="^1[0-9][0-9]$" regexp_match="true" optional="true" timeout="1000" ontimeout="late_tick" next="cancel">
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assign assign_to="fp_take" value="1"/>
      <subtract assign_to="fp_take" variable="fp_flag"/>
      <multiply assign_to="fp_ms" variable="fp_flag"/>
      <multiply assign_to="now_s" variable="fp_take"/>
      <add assign_to="fp_ms" variable="now_s"/>
      <assign assign_to="fp_flag" value="1"/>
      <test assign_to="fp_seen" variable="fp_flag" compare="equal" value="1"/>
    </action>
  </recv>
  <recv response="^2[0-9][0-9]$" regexp_match="true" optional="true" rrs="true" next="answer_ack"/>
  <recv response="^[3-6][0-9][0-9]$" regexp_match="true" next="late_final"/>

  <!-- A provisional came: CANCEL, and await the INVITE's final for 64*T1. A
       response to the CANCEL is let go; a 2xx crossing it is ACKed and its
       dialog torn down; a non-2xx is ACKed. -->
  <nop/>
  <label id="cancel"/>
  <send retrans="500" ontimeout="cancel_wait">
    <![CDATA[
      CANCEL sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-1;rport
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 CANCEL
      Max-Forwards: 70
      Content-Length: 0
    ]]>
    <action>
      <gettimeofday assign_to="cancel_t0,cancel_us"/>
    </action>
  </send>
  <label id="cancel_wait"/>
  <recv response="^1[0-9][0-9]$" regexp_match="true" optional="true" timeout="1000" ontimeout="cancel_tick" next="cancel_wait"/>
  <recv response="^2[0-9][0-9]$" regexp_match="true" optional="true" rrs="true" next="cancel_2xx">
    <action>
      <ereg regexp="[A-Z]+" search_in="hdr" header="CSeq:" assign_to="meth"/>
      <strcmp assign_to="meth_c" variable="meth" value="INVITE"/>
      <test assign_to="is_inv" variable="meth_c" compare="equal" value="0"/>
    </action>
  </recv>
  <recv response="^[3-6][0-9][0-9]$" regexp_match="true" next="cancel_final">
    <action>
      <ereg regexp="[A-Z]+" search_in="hdr" header="CSeq:" assign_to="meth"/>
      <strcmp assign_to="meth_c" variable="meth" value="INVITE"/>
      <test assign_to="is_inv" variable="meth_c" compare="equal" value="0"/>
    </action>
  </recv>
  <nop/>
  <label id="cancel_tick"/>
  <nop test="cancel_over" next="write_record">
    <action>
      <gettimeofday assign_to="el_s,el_us"/>
      <subtract assign_to="el_s" variable="cancel_t0"/>
      <test assign_to="cancel_over" variable="el_s" compare="greater_than_equal" value="32"/>
    </action>
  </nop>
  <nop next="cancel_wait"/>
  <nop/>
  <label id="cancel_2xx"/>
  <nop test="is_inv" next="answer_ack"/>
  <nop next="cancel_wait"/>
  <nop/>
  <label id="cancel_final"/>
  <nop test="is_inv" next="late_final"/>
  <nop next="cancel_wait"/>

  <!-- An INVITE non-2xx final after the deadline: ACK it; the record keeps the timeout. -->
  <nop/>
  <label id="late_final"/>
  <send next="write_record">
    <![CDATA[
      ACK sip:[field0]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-1;rport
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <!-- Answered: ACK, then hold for hold_ms answering every in-dialog OPTIONS
       (RFC 3261 section 11) in 1 s steps; a probe never restarts the hold. -->
  <nop/>
  <label id="got_answer"/>
  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:caller@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assignstr assign_to="r_se" value="[$now_s]"/>
      <assignstr assign_to="r_ans" value="[$now_s]"/>
      <assignstr assign_to="r_code" value="[$fin_code]"/>
      <assign assign_to="answered" value="1"/>
      <gettimeofday assign_to="hold_t0_s,hold_t0_us"/>
    </action>
  </send>
  <label id="hold_left"/>
  <nop test="hold_over" next="teardown">
    <action>
      <gettimeofday assign_to="hold_s,hold_us"/>
      <subtract assign_to="hold_s" variable="hold_t0_s"/>
      <multiply assign_to="hold_s" value="1000"/>
      <subtract assign_to="hold_us" variable="hold_t0_us"/>
      <divide assign_to="hold_us" value="1000"/>
      <add assign_to="hold_s" variable="hold_us"/>
      <test assign_to="hold_over" variable="hold_s" compare="greater_than_equal" variable2="hold_ms"/>
    </action>
  </nop>
  <recv request="OPTIONS" crlf="true" timeout="1000" ontimeout="hold_left"/>
  <send next="hold_left">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:caller@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <!-- A 2xx after the deadline: ACK it and tear its dialog down. -->
  <nop/>
  <label id="answer_ack"/>
  <send next="teardown">
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:caller@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
    <action>
      <assign assign_to="dialog" value="1"/>
    </action>
  </send>

  <!-- The teardown. An OPTIONS crossing the BYE is answered once the BYE
       completes (RFC 3261 section 15.1.1); a 2xx retransmission of the INVITE
       is ACKed again and the BYE re-sent (the same message, so a copy). A 481
       to the BYE means the call was already cut, unless the far end's BYE
       crossed ours; any other non-2xx ends the dialog all the same, with the
       failure recorded. -->
  <nop/>
  <label id="teardown"/>
  <send retrans="500" ontimeout="bye_no_final">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: <sip:caller@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
    <action>
      <assign assign_to="bye_sent" value="1"/>
    </action>
  </send>
  <label id="bye_wait"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="bye_wait">
    <action>
      <ereg regexp="[[:cntrl:]](([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_via_row,opt_via"/>
      <ereg regexp="[[:cntrl:]]([Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+[Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_rr_row,opt_rr"/>
      <ereg regexp=".*" search_in="hdr" header="From:" start_line="true" case_indep="true" assign_to="opt_from"/>
      <ereg regexp=".*" search_in="hdr" header="To:" start_line="true" case_indep="true" assign_to="opt_to"/>
      <ereg regexp=".*" search_in="hdr" header="CSeq:" start_line="true" case_indep="true" assign_to="opt_cseq"/>
      <assign assign_to="options_due" value="1"/>
    </action>
  </recv>
  <recv response="^1[0-9][0-9]$" regexp_match="true" optional="true" next="bye_wait"/>
  <recv response="^2[0-9][0-9]$" regexp_match="true" optional="true" next="bye_2xx">
    <action>
      <ereg regexp="[A-Z]+" search_in="hdr" header="CSeq:" assign_to="meth"/>
      <strcmp assign_to="meth_c" variable="meth" value="BYE"/>
      <test assign_to="is_bye" variable="meth_c" compare="equal" value="0"/>
    </action>
  </recv>
  <recv response="^[3-6][0-9][0-9]$" regexp_match="true" next="bye_failed">
    <action>
      <ereg regexp="SIP/2\.0 ([0-9]+)" search_in="msg" assign_to="bye_all,bye_code"/>
      <ereg regexp="[A-Z]+" search_in="hdr" header="CSeq:" assign_to="meth"/>
      <strcmp assign_to="meth_c" variable="meth" value="BYE"/>
      <test assign_to="is_bye" variable="meth_c" compare="equal" value="0"/>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <strcmp assign_to="bye_cmp" variable="bye_code" value="481"/>
      <test assign_to="bye_481" variable="bye_cmp" compare="equal" value="0"/>
    </action>
  </recv>

  <nop/>
  <label id="bye_2xx"/>
  <nop test="is_bye" next="bye_ok"/>
  <send next="teardown">
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:caller@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>
  <nop/>
  <label id="bye_ok"/>
  <nop condexec="keep_ending" condexec_inverse="true" next="released">
    <action>
      <assignstr assign_to="r_ending" value="answered"/>
      <assignstr assign_to="r_verdict" value="answered"/>
    </action>
  </nop>
  <nop next="released"/>

  <nop/>
  <label id="bye_failed"/>
  <nop test="is_bye" next="bye_failed_bye"/>
  <nop next="bye_wait"/>
  <nop/>
  <label id="bye_failed_bye"/>
  <nop test="keep_ending" next="released">
    <action>
      <assignstr assign_to="r_fail" value="[$r_fail][$r_sep]{&quot;at_ms&quot;:[$now_s],&quot;kind&quot;:&quot;dialog_request&quot;,&quot;method&quot;:&quot;BYE&quot;,&quot;code&quot;:[$bye_code]}"/>
      <assignstr assign_to="r_sep" value=","/>
    </action>
  </nop>
  <nop test="crossed" next="released">
    <action>
      <assignstr assign_to="r_ending" value="answered"/>
      <assignstr assign_to="r_verdict" value="bye_crossed"/>
    </action>
  </nop>
  <nop test="bye_481" next="released">
    <action>
      <assignstr assign_to="r_ending" value="cut"/>
      <assignstr assign_to="r_verdict" value="bye_481"/>
    </action>
  </nop>
  <nop next="released">
    <action>
      <assignstr assign_to="r_ending" value="answered"/>
      <assignstr assign_to="r_verdict" value="bye_rejected"/>
    </action>
  </nop>

  <!-- The BYE got no final: the teardown never completed. -->
  <nop/>
  <label id="bye_no_final"/>
  <nop test="keep_ending" next="write_record">
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assignstr assign_to="r_fail" value="[$r_fail][$r_sep]{&quot;at_ms&quot;:[$now_s],&quot;kind&quot;:&quot;dialog_request&quot;,&quot;method&quot;:&quot;BYE&quot;,&quot;detail&quot;:&quot;no final&quot;}"/>
      <assignstr assign_to="r_sep" value=","/>
    </action>
  </nop>
  <nop next="write_record">
    <action>
      <assignstr assign_to="r_ending" value="stranded"/>
      <assignstr assign_to="r_verdict" value="bye_no_final"/>
    </action>
  </nop>

  <nop/>
  <label id="released"/>
  <nop condexec="answered">
    <action>
      <assign assign_to="rel" value="1"/>
    </action>
  </nop>
  <send condexec="options_due">
    <![CDATA[
      SIP/2.0 200 OK
      [$opt_via]
      [$opt_rr]
      From:[$opt_from]
      To:[$opt_to]
      Call-ID: [call_id]
      CSeq:[$opt_cseq]
      Contact: <sip:caller@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>
  <nop next="write_record"/>

  <!-- Unexpected messages. An OPTIONS is answered and the call resumes the step
       it stood on; an ACK is let go. A BYE is answered: `cut` after answer,
       crossing ours during the teardown, a protocol failure before answer. Any
       other request is answered 501 and is a protocol failure: the call ends,
       its dialog torn down first when answered. A response is acted on (the
       header comment); one to a request other than the INVITE is let go. -->
  <label id="_unexp.main"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="unexp_options"/>
  <recv request="BYE" optional="true" crlf="true" next="unexp_bye"/>
  <recv request="ACK" optional="true" crlf="true" next="unexp_resume"/>
  <recv request="[A-Z]" regexp_match="true" optional="true" crlf="true" next="unexp_request">
    <action>
      <ereg regexp="^[A-Z]+" search_in="msg" assign_to="ux_req"/>
    </action>
  </recv>
  <recv response="^1[0-9][0-9]$" regexp_match="true" optional="true" counter="2" next="ux_1xx">
    <action>
      <ereg regexp="[A-Z]+" search_in="hdr" header="CSeq:" assign_to="meth"/>
      <strcmp assign_to="meth_c" variable="meth" value="INVITE"/>
      <test assign_to="is_inv" variable="meth_c" compare="equal" value="0"/>
      <ereg regexp="m=" search_in="body" assign_to="em_m"/>
      <strcmp assign_to="em_c" variable="em_m" value=""/>
      <multiply assign_to="em_c" variable="em_c"/>
      <add assign_to="em_acc" variable="em_c"/>
    </action>
  </recv>
  <recv response="^2[0-9][0-9]$" regexp_match="true" optional="true" counter="2" rrs="true" next="ux_2xx">
    <action>
      <ereg regexp="SIP/2\.0 ([0-9]+)" search_in="msg" assign_to="ux_all,ux_code"/>
      <ereg regexp="[A-Z]+" search_in="hdr" header="CSeq:" assign_to="meth"/>
      <strcmp assign_to="meth_c" variable="meth" value="INVITE"/>
      <test assign_to="is_inv" variable="meth_c" compare="equal" value="0"/>
      <strcmp assign_to="meth_b" variable="meth" value="BYE"/>
      <test assign_to="is_bye" variable="meth_b" compare="equal" value="0"/>
    </action>
  </recv>
  <recv response="^[3-6][0-9][0-9]$" regexp_match="true" counter="2" next="ux_final">
    <action>
      <ereg regexp="SIP/2\.0 ([0-9]+)" search_in="msg" assign_to="ux_all,ux_code"/>
      <ereg regexp="^[[:blank:]]*([A-Za-z0-9.+-]+)[[:blank:]]*;[^,]*cause[[:blank:]]*=[[:blank:]]*([0-9]+)" search_in="hdr" header="Reason:" assign_to="ux_rsn_all,ux_rsn_proto,ux_rsn_cause"/>
      <ereg regexp="[A-Z]+" search_in="hdr" header="CSeq:" assign_to="meth"/>
      <strcmp assign_to="meth_c" variable="meth" value="INVITE"/>
      <test assign_to="is_inv" variable="meth_c" compare="equal" value="0"/>
      <strcmp assign_to="meth_b" variable="meth" value="BYE"/>
      <test assign_to="is_bye" variable="meth_b" compare="equal" value="0"/>
    </action>
  </recv>

  <nop/>
  <label id="ux_1xx"/>
  <nop test="is_inv" next="ux_stamp"/>
  <nop next="unexp_resume"/>
  <nop/>
  <label id="ux_stamp"/>
  <nop next="unexp_resume">
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assign assign_to="fp_take" value="1"/>
      <subtract assign_to="fp_take" variable="fp_flag"/>
      <multiply assign_to="fp_ms" variable="fp_flag"/>
      <multiply assign_to="now_s" variable="fp_take"/>
      <add assign_to="fp_ms" variable="now_s"/>
      <assign assign_to="fp_flag" value="1"/>
      <test assign_to="fp_seen" variable="fp_flag" compare="equal" value="1"/>
    </action>
  </nop>

  <nop/>
  <label id="ux_2xx"/>
  <nop test="writing" next="unexp_resume"/>
  <nop test="is_inv" next="ux_2xx_inv"/>
  <nop test="is_bye" next="ux_2xx_bye"/>
  <nop next="unexp_resume"/>
  <nop/>
  <label id="ux_2xx_bye"/>
  <nop test="bye_sent" next="bye_ok">
    <action>
      <assign assign_to="_unexp.retaddr" value="0"/>
    </action>
  </nop>
  <nop next="unexp_resume"/>
  <nop/>
  <label id="ux_2xx_inv"/>
  <nop test="answered" next="ux_reack"/>
  <nop test="dialog" next="ux_reack"/>
  <nop test="keep_ending" next="answer_ack">
    <action>
      <assign assign_to="_unexp.retaddr" value="0"/>
      <assignstr assign_to="fin_code" value="[$ux_code]"/>
    </action>
  </nop>
  <nop next="got_answer"/>
  <nop/>
  <label id="ux_reack"/>
  <send next="unexp_resume">
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: <sip:caller@[local_ip]:[local_port]>;tag=[pid]-[call_number]-[run]
      To: <sip:[field0]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:caller@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <nop/>
  <label id="ux_final"/>
  <nop test="writing" next="unexp_resume"/>
  <nop test="is_inv" next="ux_final_inv"/>
  <nop test="is_bye" next="ux_final_bye"/>
  <nop next="unexp_resume"/>
  <nop/>
  <label id="ux_final_bye"/>
  <nop test="bye_sent" next="bye_failed_bye">
    <action>
      <assign assign_to="_unexp.retaddr" value="0"/>
      <assignstr assign_to="bye_code" value="[$ux_code]"/>
      <strcmp assign_to="bye_cmp" variable="bye_code" value="481"/>
      <test assign_to="bye_481" variable="bye_cmp" compare="equal" value="0"/>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
    </action>
  </nop>
  <nop next="unexp_resume"/>
  <nop/>
  <label id="ux_final_inv"/>
  <nop test="answered" next="ux_final_after_2xx"/>
  <nop test="dialog" next="ux_final_after_2xx"/>
  <nop test="keep_ending" next="late_final">
    <action>
      <assign assign_to="_unexp.retaddr" value="0"/>
      <assignstr assign_to="fin_code" value="[$ux_code]"/>
      <assignstr assign_to="rsn_proto" value="[$ux_rsn_proto]"/>
      <assignstr assign_to="rsn_cause" value="[$ux_rsn_cause]"/>
    </action>
  </nop>
  <nop condexec="ux_rsn_all">
    <action>
      <assign assign_to="rsn_all" value="1"/>
    </action>
  </nop>
  <nop next="got_reject"/>

  <!-- A non-2xx final for the INVITE after its 2xx: the INVITE transaction
       ended on the 2xx (RFC 3261 section 17.1.1.2), so the response is let go.
       The call keeps its ending and its ACK/BYE path; the first such final is
       a protocol failure of the record. -->
  <nop/>
  <label id="ux_final_after_2xx"/>
  <nop test="late_final_seen" next="unexp_resume"/>
  <nop next="unexp_resume">
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assignstr assign_to="r_fail" value="[$r_fail][$r_sep]{&quot;at_ms&quot;:[$now_s],&quot;kind&quot;:&quot;protocol&quot;,&quot;method&quot;:&quot;INVITE&quot;,&quot;code&quot;:[$ux_code],&quot;detail&quot;:&quot;second final after 2xx&quot;}"/>
      <assignstr assign_to="r_sep" value=","/>
      <assign assign_to="late_final_seen" value="1"/>
    </action>
  </nop>

  <nop/>
  <label id="unexp_options"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:caller@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>
  <label id="unexp_resume"/>
  <nop>
    <action>
      <jump variable="_unexp.retaddr"/>
      <assign assign_to="_unexp.retaddr" value="0"/>
    </action>
  </nop>

  <nop/>
  <label id="unexp_bye"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:caller@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
    <action>
      <assignstr assign_to="ux_what" value="BYE before answer"/>
    </action>
  </send>
  <nop test="bye_sent" next="unexp_resume">
    <action>
      <assign assign_to="crossed" value="1"/>
    </action>
  </nop>
  <nop test="answered" next="released">
    <action>
      <assign assign_to="_unexp.retaddr" value="0"/>
      <assignstr assign_to="r_ending" value="cut"/>
      <assignstr assign_to="r_verdict" value="bye_from_far_end"/>
    </action>
  </nop>
  <nop next="unexp_note"/>

  <nop/>
  <label id="unexp_request"/>
  <send>
    <![CDATA[
      SIP/2.0 501 Not Implemented
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
    <action>
      <assign assign_to="_unexp.retaddr" value="0"/>
      <assignstr assign_to="ux_what" value="[$ux_req]"/>
    </action>
  </send>
  <label id="unexp_note"/>
  <nop test="answered" next="teardown">
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <assignstr assign_to="r_fail" value="[$r_fail][$r_sep]{&quot;at_ms&quot;:[$now_s],&quot;kind&quot;:&quot;protocol&quot;,&quot;detail&quot;:&quot;unexpected [$ux_what]&quot;}"/>
      <assignstr assign_to="r_sep" value=","/>
      <assignstr assign_to="r_ending" value="failed"/>
      <assignstr assign_to="r_verdict" value="unexpected_request"/>
      <assign assign_to="keep_ending" value="1"/>
    </action>
  </nop>
  <nop next="write_record">
    <action>
      <assignstr assign_to="r_reason" value="&quot;protocol&quot;"/>
      <assignstr assign_to="r_code" value="null"/>
    </action>
  </nop>

  <!-- The record. The phase reached comes from what the call saw. -->
  <nop/>
  <label id="write_record"/>
  <nop>
    <action>
      <assign assign_to="writing" value="1"/>
      <assignstr assign_to="r_phase" value="invited"/>
      <assignstr assign_to="r_fp" value="null"/>
    </action>
  </nop>
  <nop condexec="fp_seen">
    <action>
      <assignstr assign_to="r_phase" value="provisional"/>
      <assignstr assign_to="r_fp" value="[$fp_ms]"/>
    </action>
  </nop>
  <nop condexec="answered">
    <action>
      <assignstr assign_to="r_phase" value="answered"/>
    </action>
  </nop>
  <nop condexec="rel">
    <action>
      <assignstr assign_to="r_phase" value="released"/>
    </action>
  </nop>
  <nop>
    <action>
      <gettimeofday assign_to="now_s,now_us"/>
      <multiply assign_to="now_s" value="1000"/>
      <divide assign_to="now_us" value="1000"/>
      <add assign_to="now_s" variable="now_us"/>
      <test assign_to="r_em" variable="em_acc" compare="greater_than" value="0"/>
      <log message="{&quot;schema&quot;:&quot;call-outcome.v1&quot;,&quot;run&quot;:&quot;[run]&quot;,&quot;source&quot;:&quot;sipp&quot;,&quot;stream&quot;:&quot;[stream]&quot;,&quot;shape&quot;:&quot;[shape]&quot;,&quot;call_id&quot;:&quot;[call_id]&quot;,&quot;started_at_ms&quot;:[$t_start],&quot;first_provisional_at_ms&quot;:[$r_fp],&quot;setup_ended_at_ms&quot;:[$r_se],&quot;answered_at_ms&quot;:[$r_ans],&quot;ended_at_ms&quot;:[$now_s],&quot;phase_reached&quot;:&quot;[$r_phase]&quot;,&quot;early_media&quot;:[$r_em],&quot;final_code&quot;:[$r_code],&quot;reason&quot;:[$r_reason],&quot;ending&quot;:&quot;[$r_ending]&quot;,&quot;failures&quot;:\x5B[$r_fail]\x5D,&quot;producer_verdict&quot;:&quot;[$r_verdict]&quot;}"/>
    </action>
  </nop>

  <Reference variables="opt_via_row,opt_rr_row,fin_all,rsn_all,bye_all,ux_all,setup_str,hold_str,el_us,now_us,hold_us,t_start_us,cancel_us"/>
  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200"/>
  <CallLengthRepartition value="100, 1000, 10000, 30000, 60000, 120000"/>
</scenario>
