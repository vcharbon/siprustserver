#!/usr/bin/env bash
# Recovered when every pod of the namespace bound to a stopped node is Ready
# again and as many target pods are live as before. Exit 75 while not yet.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
while read -r n; do
  pending="$(kubectl -n "$NS" get pods --field-selector "spec.nodeName=$n" -o json \
    | jq -r '.items[] | select(.status.phase != "Succeeded") | select(any(.status.conditions[]?; .type == "Ready" and .status == "True") | not) | .metadata.name')" \
    || exit "$HK_NOT_YET"
  [ -z "$pending" ] || exit "$HK_NOT_YET"
done < "$HAKIT_EVENT_DIR/nodes"
[ "$(hk_live_pods | grep -c . || true)" -ge "$(cat "$HAKIT_EVENT_DIR/live_before")" ] || exit "$HK_NOT_YET"
jq -cn --argjson at "$(hk_now_ms)" '{all_ready_at_ms: $at}'
