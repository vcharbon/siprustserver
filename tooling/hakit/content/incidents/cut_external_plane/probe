#!/usr/bin/env bash
# Recovered when exactly one live proxy holds the virtual address. Exit 75
# while not yet, or while the addresses cannot be read. Facts: the holder and
# whether the address moved.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=vip.sh
source "$HAKIT_LIB/vip.sh"
holders="$(hk_vip_holders "$HAKIT_PARAM_ADDRESS" "$HAKIT_PARAM_CONTAINER")" || exit "$HK_NOT_YET"
[ "$(hk_count <<<"$holders")" -eq 1 ] || exit "$HK_NOT_YET"
read -r pod node _ <<<"$holders"
read -r cut _ < "$HAKIT_EVENT_DIR/cut"
if [ "$node" != "$cut" ]; then moved=true; else moved=false; fi
jq -cn --arg pod "$pod" --arg node "$node" --argjson moved "$moved" '{holder: $pod, holder_node: $node, moved: $moved}'
