#!/usr/bin/env bash
# Reconnect the cut node to the callers' network at its own address.
# Idempotent: a node already connected is left alone. With equal VRRP
# priorities the addresses stay with the peer.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
[ -s "$HAKIT_EVENT_DIR/cut" ] || { echo '{}'; exit 0; }
read -r node ip < "$HAKIT_EVENT_DIR/cut"
now="$(docker inspect -f "{{with index .NetworkSettings.Networks \"$HAKIT_PARAM_NETWORK\"}}{{.IPAddress}}{{end}}" "$node")"
if [ -z "$now" ]; then
  docker network connect --ip "$ip" "$HAKIT_PARAM_NETWORK" "$node" >&2
fi
now="$(docker inspect -f "{{with index .NetworkSettings.Networks \"$HAKIT_PARAM_NETWORK\"}}{{.IPAddress}}{{end}}" "$node")"
[ "$now" = "$ip" ] || hk_die "$node is on $HAKIT_PARAM_NETWORK as '${now}', not $ip"
jq -cn --arg node "$node" --arg ip "$ip" --argjson at "$(hk_now_ms)" '{node: $node, address: $ip, reconnected_at_ms: $at}'
