#!/usr/bin/env bash
# Drop every frame to or from the next hop's MAC on each target node's external
# interface, then wait until each node left both VIPs' next hops and its proxy
# read its external face unfit. Facts: the targets, the instant, and in ms after
# it each VIP's withdrawal and each proxy's first such reading, polled per node
# from the moment the frames drop, beside the wait for the routes.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=route.sh
source "$HAKIT_LIB/route.sh"
hk_pick_targets
nodes="$(hk_targets | awk '{ print $3 }')"
pairs="$(for node in $nodes; do hk_route_pairs "$node" || exit 1; done)" || hk_die "the addresses of $nodes cannot be read"
at="$(hk_now_ms)"
deadline=$(( at + HAKIT_PARAM_WITHDRAW_TIMEOUT_S * 1000 ))
# The instant `node`'s proxy first reads its external face unfit, in its own
# file of the event directory; fails at the deadline.
first_unfit() { # node
  until [[ "$(docker exec "$1" curl -s -m 1 127.0.0.1:9090/fitz || true)" == "unfit external-face"* ]]; do
    [ "$(hk_now_ms)" -lt "$deadline" ] || return 1
    sleep 0.2
  done
  hk_now_ms > "$HAKIT_EVENT_DIR/unfit-$1"
}
for node in $nodes; do
  neighbour="$(docker exec "$node" ip -j neigh show to "$HAKIT_PARAM_NEXT_HOP" dev "$HAKIT_PARAM_INTERFACE")" || hk_die "the neighbour table of $node cannot be read"
  mac="$(jq -r '.[0].lladdr // empty' <<<"$neighbour")"
  [ -n "$mac" ] || hk_die "$node holds no address for $HAKIT_PARAM_NEXT_HOP"
  echo "$node" >> "$HAKIT_EVENT_DIR/silenced"
  docker exec -i "$node" nft -f - >&2 <<EOF
table netdev hakit_next_hop_dead {
  chain in {
    type filter hook ingress device "$HAKIT_PARAM_INTERFACE" priority -500; policy accept;
    ether saddr $mac drop
  }
  chain out {
    type filter hook egress device "$HAKIT_PARAM_INTERFACE" priority -500; policy accept;
    ether daddr $mac drop
  }
}
EOF
done
watchers=()
for node in $nodes; do
  first_unfit "$node" >/dev/null 2>&1 &
  watchers+=("$!")
done
withdrawn="$(hk_route_wait absent "$at" "$HAKIT_PARAM_WITHDRAW_TIMEOUT_S" "$pairs")" \
  || hk_die "$nodes still announce a VIP ${HAKIT_PARAM_WITHDRAW_TIMEOUT_S}s after the next hop died"
for watcher in "${watchers[@]}"; do
  wait "$watcher" || hk_die "a proxy of $nodes still reads its external face fit ${HAKIT_PARAM_WITHDRAW_TIMEOUT_S}s after the next hop died"
done
unfit="{}"
for node in $nodes; do
  unfit="$(jq -c --arg n "$node" --argjson ms $(( $(cat "$HAKIT_EVENT_DIR/unfit-$node") - at )) '. + {($n): $ms}' <<<"$unfit")"
done
jq -cn --argjson pods "$(hk_target_pods_json)" --argjson at "$at" --argjson w "$withdrawn" --argjson u "$unfit" \
  '{pods: $pods, cut_at_ms: $at, applied_at_ms: $at, withdrawn_ms: $w, unfit_ms: $u}'
