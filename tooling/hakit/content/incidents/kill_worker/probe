#!/usr/bin/env bash
# Recovered when the crashed worker's containers restarted and it is Ready
# again, with no overlap between the crashed incarnation and its successor.
# Exit 75 while not yet. Facts: per container its restart, Ready and overlap;
# each survivor's peer park and each proxy's registry leave and join
# (lib/worker.sh).
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=crash.sh
source "$HAKIT_LIB/crash.sh"
# shellcheck source=worker.sh
source "$HAKIT_LIB/worker.sh"
crashed="$(hk_probe_crashed)"
read -r pod _ _ <<<"$(hk_targets)"
timings="$(hk_worker_timings "$pod" "$(cat "$HAKIT_EVENT_DIR/killed_at_ms")")"
jq -cn --argjson c "$crashed" --argjson t "$timings" '$c + $t'
