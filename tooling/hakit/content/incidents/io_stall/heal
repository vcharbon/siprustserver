#!/usr/bin/env bash
# Delete the event's IOChaos; Chaos Mesh removes the latency before the
# resource is gone. Idempotent. Facts: the recovered instant.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=chaos-mesh.sh
source "$HAKIT_LIB/chaos-mesh.sh"
at="$(hk_cm_delete iochaos 90)"
jq -cn --argjson at "$at" '{recovered_at_ms: $at}'
