#!/usr/bin/env bash
# Recovered when every stopped node is Ready and every pod of the namespace
# bound to it reads Ready. Exit 75 while not yet, or while they cannot be read.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
nodes="$(hk_state nodes)"
while read -r n; do
  [ -n "$n" ] || continue
  ready="$(kubectl get node "$n" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}')" || exit "$HK_NOT_YET"
  [ "$ready" = True ] || exit "$HK_NOT_YET"
  pods="$(kubectl -n "$NS" get pods --field-selector "spec.nodeName=$n" -o json)" || exit "$HK_NOT_YET"
  pending="$(jq -r '.items[] | select(.status.phase != "Succeeded")
    | select(any(.status.conditions[]?; .type == "Ready" and .status == "True") | not) | .metadata.name' <<<"$pods")"
  [ -z "$pending" ] || exit "$HK_NOT_YET"
done <<<"$nodes"
jq -cn --argjson at "$(hk_now_ms)" '{all_ready_at_ms: $at}'
