#!/usr/bin/env bash
# Delete the event's NetworkChaos; Chaos Mesh restores the pods' network
# before the resource is gone. Idempotent. Facts: the recovered instant.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=chaos-mesh.sh
source "$HAKIT_LIB/chaos-mesh.sh"
at="$(hk_cm_delete networkchaos 90)"
jq -cn --argjson at "$at" '{recovered_at_ms: $at}'
