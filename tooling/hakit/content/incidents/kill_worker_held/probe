#!/usr/bin/env bash
# Recovered as kill_worker's probe says, with the absence proven: the pod that
# came back is the one that waited Pending through the hold (one incarnation),
# and it was scheduled no earlier than the release (the condition has a 1 s
# resolution). A replacement that ran during the hold fails the probe.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=worker.sh
source "$HAKIT_LIB/worker.sh"
replaced="$(hk_probe_replaced)"
read -r pod _ _ < <(hk_targets)
pending="$(cat "$HAKIT_EVENT_DIR/pending_uid")"
released="$(cat "$HAKIT_EVENT_DIR/released_at_ms")"
row="$(kubectl -n "$NS" get pod "$pod" -o jsonpath='{.metadata.uid}{" "}{.status.conditions[?(@.type=="PodScheduled")].lastTransitionTime}')"
read -r uid scheduled <<<"$row"
scheduled_ms="$(hk_ms "$scheduled")"
[ "$uid" = "$pending" ] || hk_die "$pod came back as $uid, not the replacement $pending that waited through the hold"
[ "$scheduled_ms" != null ] && [ "$scheduled_ms" -ge $(( released - 1000 )) ] \
  || hk_die "$pod was scheduled at $scheduled, before the release at $released"
timings="$(hk_worker_timings "$pod" "$(cat "$HAKIT_EVENT_DIR/killed_at_ms")")"
jq -cn --argjson r "$replaced" --argjson t "$timings" --argjson s "$scheduled_ms" --argjson rel "$released" \
  '$r + $t + {scheduled_at_ms: $s, released_at_ms: $rel, incarnations: 1}'
