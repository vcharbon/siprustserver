#!/usr/bin/env bash
# netem loss on the target pods' eth0 (egress; at 100 % the pod is cut off,
# the kubelet's probes included). A host-network pod's netns is its node's:
# refused unless allow_host_network. Facts as pod_freeze's.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=timed.sh
source "$HAKIT_LIB/timed.sh"
hk_pick_targets
hk_refuse_host_network "$HAKIT_PARAM_ALLOW_HOST_NETWORK"
hk_timed_inject netem pf_loss "$HAKIT_PARAM_LOSS_PCT"
