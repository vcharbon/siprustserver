#!/usr/bin/env bash
# Force-delete the front proxy that holds the virtual address (the VRRP
# master); its peer must take the address over. Facts: the pod, its node and
# interface, the live proxies before, the delete instant.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=vip.sh
source "$HAKIT_LIB/vip.sh"
holders="$(hk_vip_holders "$HAKIT_PARAM_ADDRESS" "$HAKIT_PARAM_CONTAINER")"
[ "$(grep -c . <<<"$holders" || true)" -eq 1 ] || hk_die "expected one holder of $HAKIT_PARAM_ADDRESS, found: ${holders:-none}"
read -r pod node ifc <<<"$holders"
hk_live_pods | awk -v p="$pod" '$1 == p' > "$HAKIT_EVENT_DIR/targets"
hk_live_pods | grep -c . > "$HAKIT_EVENT_DIR/live_before"
deleted="$(hk_delete_targets 0)"
jq -cn --argjson d "$deleted" --arg node "$node" --arg ifc "$ifc" '$d + {node: $node, interface: $ifc}'
