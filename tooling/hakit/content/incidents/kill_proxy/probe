#!/usr/bin/env bash
# Recovered when the killed proxy is replaced, as many proxies are live as
# before, and exactly one of them holds the virtual address. Exit 75 while not
# yet. Facts: the replacement's start and Ready, the new holder.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=vip.sh
source "$HAKIT_LIB/vip.sh"
replaced="$(hk_probe_replaced)"
holders="$(hk_vip_holders "$HAKIT_PARAM_ADDRESS" "$HAKIT_PARAM_CONTAINER")"
[ "$(grep -c . <<<"$holders" || true)" -eq 1 ] || exit "$HK_NOT_YET"
read -r pod node _ <<<"$holders"
jq -cn --argjson r "$replaced" --arg pod "$pod" --arg node "$node" '$r + {holder: $pod, holder_node: $node}'
