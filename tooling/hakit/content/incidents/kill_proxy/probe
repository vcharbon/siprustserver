#!/usr/bin/env bash
# Recovered when the crashed proxy's containers restarted with no overlap, it
# is Ready again, and both VIPs are routed over every live proxy's node. Exit
# 75 while not yet, or while a read fails. Facts: the crash's restart
# timings, the next hops.
# shellcheck source=incident.sh
source "$HAKIT_LIB/incident.sh"
# shellcheck source=route.sh
source "$HAKIT_LIB/route.sh"
# shellcheck source=crash.sh
source "$HAKIT_LIB/crash.sh"
crashed="$(hk_probe_crashed)"
routes="$(hk_probe_routed_over_live)"
jq -cn --argjson c "$crashed" --argjson r "$routes" --argjson at "$(hk_now_ms)" \
  '$c + {next_hops: $r, announced_at_ms: $at}'
