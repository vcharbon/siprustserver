<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- Receives the INVITE and never answers. -->
<scenario name="peer-silent">
  <recv request="INVITE" crlf="true"/>
  <recv request="INVITE" crlf="true" timeout="6000" ontimeout="done"/>
  <label id="done"/>
</scenario>
