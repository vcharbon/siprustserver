#!/usr/bin/env bash
# The site (s6 longrun `site`): `siprig-site`, the pack's where it ships one,
# with the store's environment the first step wrote. It reads the workspace
# itself (SIPRIG_WORKSPACE): its port, bind address and public URL from rig.toml.
set -euo pipefail
exec 2>&1
set -a
# shellcheck disable=SC1091
. /run/siprig/workspace.env
set +a
exec siprig-site
