#!/usr/bin/env bash
# The site (s6 longrun `site`): `siprig-site`, the pack's where it ships one,
# with the store's environment the first step wrote. It reads the workspace
# itself (SIPRIG_WORKSPACE): its port, bind address and public URL from rig.toml.
# s6-notifyoncheck runs the service's data/check (image/site-check) each second
# until the site answers; its readiness line goes to /dev/null, never to s6, so
# the start (s6-rc) never waits on the site and a halt from the site's finish
# (image/site-finish, where it exits before it ever answered) is never blocked.
set -euo pipefail
exec 2>&1
set -a
# shellcheck disable=SC1091
. /run/siprig/workspace.env
set +a
exec 3>/dev/null
exec s6-notifyoncheck -3 3 -n 0 -w 1000 -t 10000 siprig-site
