#!/usr/bin/env bash
# The site's finish (s6 runs it each time the site exits, with its exit code
# and signal). A site that exits before it ever answered in this container
# (no /run/siprig/site-answered, image/site-check) would only fail again on
# every restart: the container stops with status 3, the line naming the
# site's log, and the wrapper's `up` prints that log's tail. A site that has
# answered once is restarted by s6.
#
# SIPRIG_RUN_DIR (for /run/siprig), SIPRIG_EXITCODE_FILE (for s6's container
# exit code file) and SIPRIG_HALT (for s6's halt) name others than the image's.
set -euo pipefail
run="${SIPRIG_RUN_DIR:-/run/siprig}"
exitcode_file="${SIPRIG_EXITCODE_FILE:-/run/s6-linux-init-container-results/exitcode}"
halt="${SIPRIG_HALT:-/run/s6/basedir/bin/halt}"

# How the site ended, from s6's finish arguments: its exit code, or 256 and the signal that killed it.
how_it_ended() {
  if [ "${1:-}" = 256 ]; then echo "was killed by signal ${2:-?}"; else echo "exited with code ${1:-?}"; fi
}

[ ! -e "$run/site-answered" ] || exit 0
echo "siprig: the site $(how_it_ended "$@") before it ever answered:" \
  "its log is $SIPRIG_WORKSPACE/logs/site/current; the container stops" >&2
echo 3 > "$exitcode_file"
exec "$halt"
