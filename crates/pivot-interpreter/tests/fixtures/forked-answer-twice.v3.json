 "case": {
  "annotations": {
   "notes": [
    "Two forks f1/f2 of one INVITE ring and both answer 2xx under their own To-tags: each fork is its own UAS, so the second 2xx is a final of its own, never a moot second final of the first fork's.",
    "The system keeps the first dialog and, as RFC 3261 \u00a713.2.2.4 says, ACKs the second fork's 2xx and BYEs it; the caller then hangs up the first."
   ]
  },
  "family": "fork",
  "id": "forked-answer-twice",
  "lanes": {
   "upstream-fake": "ok"
  },
  "origin": "authored",
  "title": "a forking callee answers 2xx on two early dialogs; the system ACKs and BYEs the later one",
  "variant": "repro"
