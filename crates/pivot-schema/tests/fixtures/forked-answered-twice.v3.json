  "case": {
    "annotations": {
      "notes": [
        "One INVITE answered 2xx under two To-tags is two dialogs, each confirmed by its own ACK (RFC 3261 section 13.2.2.4): the second fork's 2xx and the ACK expected for it name the fork inside the confirmed dialog, and the marker is stated once per dialog.",
        "The first fork's ACK and every ACK the caller sends name no fork; the caller BYEs the first dialog once confirmed, keeps the second, re-INVITEs it and BYEs it."
      ]
    },
    "family": "transparent",
    "id": "forked-answered-twice",
    "lanes": {
      "upstream-fake": "ok"
    },
    "origin": "authored",
    "title": "a forking callee answers 2xx under two early dialogs and the caller confirms both",
    "variant": "repro"
  },
