{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true
  },
  "include": ["cases.ts", "judges", "collectors", "operations", "test", "vitest.config.ts"]
}
