{
  "name": "@sip/basic-case",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The minimal case form: two parties as plain SIP addresses, the basic_call and invite_reject shapes on a pivot step builder, compiled to the cells a case source yields.",
