    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sip/corpus": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.111",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
