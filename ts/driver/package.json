{
  "name": "@sip/driver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "One cell of a campaign matrix, rust-test or pivot-replay, run into its caller's run dir and answered as the campaign.json line its caller folds.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sip/contracts": "workspace:*",
    "@sip/pipeline": "workspace:*",
    "@sip/toolchain": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.111",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
