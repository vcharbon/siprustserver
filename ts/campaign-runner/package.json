{
  "name": "@sip/campaign-runner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A campaign run over a pack's cases: its cells compiled and replayed on each lane under their locks and the lane's pacing, retried, judged into verification lines, recorded in the run store, and reported (JUnit included).",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sip/contracts": "workspace:*",
    "@sip/corpus": "workspace:*",
    "@sip/rig": "workspace:*",
    "@sip/store": "workspace:*",
    "@sip/toolchain": "workspace:*",
    "@sip/workspace": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.111",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
