{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "siprust chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "fullImage": {
      "allOf": [
        {
          "$ref": "#/definitions/image"
        },
        {
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        }
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "description": "Plain env by name; values are strings, null removes a default.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "optionalPositive": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "podLabels": {
      "type": "object",
      "description": "Pod labels over the selector label `app`, which they never replace.",
      "propertyNames": {
        "not": {
          "const": "app"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "virtualIp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "interface"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "interface": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trackScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "script"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "fall": {
          "type": "integer",
          "minimum": 1
        },
        "rise": {
          "type": "integer",
          "minimum": 1
        },
        "weight": {
          "type": "integer",
          "minimum": -253,
          "maximum": 253
        }
      }
    }
  },
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "image": {
      "$ref": "#/definitions/fullImage"
    },
    "keepalivedImage": {
      "$ref": "#/definitions/fullImage"
    },
    "imagePullSecrets": {
      "$ref": "#/definitions/objects"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxyVip": {
          "type": "string"
        },
        "internalInterface": {
          "type": "string"
        },
        "externalVip": {
          "type": "string"
        },
        "externalInterface": {
          "type": "string"
        },
        "externalSubnet": {
          "type": "string"
        },
        "sipPort": {
          "$ref": "#/definitions/port"
        },
        "internalCidrs": {
          "type": "string"
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlpEndpoint": {
          "type": "string"
        },
        "traceHeader": {
          "type": "boolean"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "$ref": "#/definitions/count"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "$ref": "#/definitions/command"
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "dest": {
          "type": "string"
        },
        "outboundProxy": {
          "type": "boolean"
        },
        "replication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "$ref": "#/definitions/port"
            }
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "extraEnv": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumes": {
          "$ref": "#/definitions/objects"
        },
        "extraContainers": {
          "$ref": "#/definitions/objects"
        },
        "extraInitContainers": {
          "$ref": "#/definitions/objects"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/podLabels"
        },
        "terminationGracePeriodSeconds": {
          "$ref": "#/definitions/count"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/objects"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/objects"
        },
        "extraPorts": {
          "$ref": "#/definitions/objects"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "sysctls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ]
          }
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "$ref": "#/definitions/count"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "$ref": "#/definitions/command"
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "recvShards": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1024
        },
        "selfGate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpsRate": {
              "$ref": "#/definitions/optionalPositive"
            },
            "cpsSize": {
              "$ref": "#/definitions/optionalPositive"
            }
          }
        },
        "hmac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "kid": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "unresQlenBytes": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "extraEnv": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumes": {
          "$ref": "#/definitions/objects"
        },
        "extraContainers": {
          "$ref": "#/definitions/objects"
        },
        "extraInitContainers": {
          "$ref": "#/definitions/objects"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/podLabels"
        },
        "terminationGracePeriodSeconds": {
          "$ref": "#/definitions/count"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/objects"
        },
        "extraPorts": {
          "$ref": "#/definitions/objects"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "sysctls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ]
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "keepalived": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "virtualRouterId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "extraVirtualIps": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/virtualIp"
              }
            },
            "extraTrackScripts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/trackScript"
              }
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        }
      }
    },
    "callLimiter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "$ref": "#/definitions/command"
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "leaseSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "extraEnv": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumes": {
          "$ref": "#/definitions/objects"
        },
        "extraContainers": {
          "$ref": "#/definitions/objects"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/podLabels"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/objects"
        }
      }
    },
    "cdr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "rabbitmq": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "$ref": "#/definitions/fullImage"
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "minLength": 1
            },
            "podAnnotations": {
              "$ref": "#/definitions/stringMap"
            },
            "storeSizeLimit": {
              "type": "string"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "nodeSelector": {
              "$ref": "#/definitions/stringMap"
            },
            "tolerations": {
              "$ref": "#/definitions/objects"
            }
          }
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/definitions/image"
            },
            "command": {
              "$ref": "#/definitions/command"
            },
            "args": {
              "$ref": "#/definitions/args"
            },
            "payload": {
              "enum": [
                "json",
                "opaque"
              ]
            },
            "observationUrl": {
              "type": "string",
              "pattern": "^(http://[^/]+/?)?$"
            },
            "env": {
              "$ref": "#/definitions/env"
            },
            "extraEnv": {
              "$ref": "#/definitions/objects"
            },
            "extraVolumeMounts": {
              "$ref": "#/definitions/objects"
            },
            "extraVolumes": {
              "$ref": "#/definitions/objects"
            },
            "extraContainers": {
              "$ref": "#/definitions/objects"
            },
            "podAnnotations": {
              "$ref": "#/definitions/stringMap"
            },
            "podLabels": {
              "$ref": "#/definitions/podLabels"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "nodeSelector": {
              "$ref": "#/definitions/stringMap"
            },
            "tolerations": {
              "$ref": "#/definitions/objects"
            }
          }
        }
      }
    },
    "masqExempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    }
  }
}
