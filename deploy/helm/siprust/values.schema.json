{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "siprust chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "fullImage": {
      "allOf": [
        {
          "$ref": "#/definitions/image"
        },
        {
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        }
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "description": "Plain env by name; values are strings, null removes a default.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "disruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": "integer", "minimum": 1 }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "optionalPositive": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "podLabels": {
      "type": "object",
      "description": "Pod labels over the selector label `app`, which they never replace.",
      "propertyNames": {
        "not": {
          "const": "app"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "asn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "bgpPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "asn"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "asn": {
          "$ref": "#/definitions/asn"
        }
      }
    }
  },
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "image": {
      "$ref": "#/definitions/fullImage"
    },
    "netToolsImage": {
      "$ref": "#/definitions/fullImage"
    },
    "imagePullSecrets": {
      "$ref": "#/definitions/objects"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxyVip": {
          "type": "string"
        },
        "externalVip": {
          "type": "string"
        },
        "externalInterface": {
          "type": "string"
        },
        "externalNextHops": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "ipv4",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
          }
        },
        "externalSubnet": {
          "type": "string"
        },
        "sipPort": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlpEndpoint": {
          "type": "string"
        },
        "traceHeader": {
          "type": "boolean"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "$ref": "#/definitions/count"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "$ref": "#/definitions/command"
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "dest": {
          "type": "string"
        },
        "clusterKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "replication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "$ref": "#/definitions/port"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "proxyNodeCidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
              }
            },
            "monitoringNamespace": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "extraEnv": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumes": {
          "$ref": "#/definitions/objects"
        },
        "extraContainers": {
          "$ref": "#/definitions/objects"
        },
        "extraInitContainers": {
          "$ref": "#/definitions/objects"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/podLabels"
        },
        "terminationGracePeriodSeconds": {
          "$ref": "#/definitions/count"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/disruptionBudget"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/objects"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/objects"
        },
        "extraPorts": {
          "$ref": "#/definitions/objects"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "sysctls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ]
          }
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "$ref": "#/definitions/count"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "$ref": "#/definitions/command"
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "recvShards": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1024
        },
        "selfGate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpsRate": {
              "$ref": "#/definitions/optionalPositive"
            },
            "cpsSize": {
              "$ref": "#/definitions/optionalPositive"
            }
          }
        },
        "hmac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "drawInCluster": {
              "type": "boolean"
            },
            "kid": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "unresQlenBytes": {
          "type": "integer",
          "minimum": 1
        },
        "neighbour": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseReachableTimeMs": { "type": "integer", "minimum": 1 },
            "delayFirstProbeSeconds": { "type": "integer", "minimum": 1 },
            "ucastSolicit": { "type": "integer", "minimum": 1 },
            "mcastSolicit": { "type": "integer", "minimum": 1 },
            "retransTimeMs": { "type": "integer", "minimum": 1 }
          }
        },
        "readinessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "announce": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "$ref": "#/definitions/port"
            },
            "loadBalancerClass": {
              "type": [
                "string",
                "null"
              ]
            },
            "propagationMs": {
              "type": "integer",
              "minimum": 1
            },
            "metallb": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "myASN": {
                  "$ref": "#/definitions/asn"
                },
                "peers": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "internal": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/bgpPeer"
                      }
                    },
                    "external": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/bgpPeer"
                      }
                    }
                  }
                },
                "bfd": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "receiveIntervalMs": {
                      "type": "integer",
                      "minimum": 10,
                      "maximum": 60000
                    },
                    "transmitIntervalMs": {
                      "type": "integer",
                      "minimum": 10,
                      "maximum": 60000
                    },
                    "detectMultiplier": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 255
                    }
                  }
                },
                "connectTimeSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "extraEnv": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumes": {
          "$ref": "#/definitions/objects"
        },
        "extraContainers": {
          "$ref": "#/definitions/objects"
        },
        "extraInitContainers": {
          "$ref": "#/definitions/objects"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/podLabels"
        },
        "terminationGracePeriodSeconds": {
          "$ref": "#/definitions/count"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/disruptionBudget"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/objects"
        },
        "extraPorts": {
          "$ref": "#/definitions/objects"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "sysctls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ]
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "egressRoutes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "routeGuard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "peers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "ipv4"
              }
            },
            "pollMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 10000
            },
            "deadMs": {
              "type": "integer",
              "minimum": 40,
              "maximum": 600000
            },
            "holdMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600000
            },
            "metricsPort": {
              "$ref": "#/definitions/port"
            },
            "withdrawWithinMs": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        }
      }
    },
    "callLimiter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "$ref": "#/definitions/command"
        },
        "args": {
          "$ref": "#/definitions/args"
        },
        "leaseSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "extraEnv": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumeMounts": {
          "$ref": "#/definitions/objects"
        },
        "extraVolumes": {
          "$ref": "#/definitions/objects"
        },
        "extraContainers": {
          "$ref": "#/definitions/objects"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/podLabels"
        },
        "securityContext": {
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "$ref": "#/definitions/count"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/objects"
        }
      }
    },
    "cdr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "rabbitmq": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "$ref": "#/definitions/fullImage"
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "minLength": 1
            },
            "podAnnotations": {
              "$ref": "#/definitions/stringMap"
            },
            "storeSizeLimit": {
              "type": "string"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "nodeSelector": {
              "$ref": "#/definitions/stringMap"
            },
            "tolerations": {
              "$ref": "#/definitions/objects"
            }
          }
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/definitions/image"
            },
            "command": {
              "$ref": "#/definitions/command"
            },
            "args": {
              "$ref": "#/definitions/args"
            },
            "payload": {
              "enum": [
                "json",
                "opaque"
              ]
            },
            "observationUrl": {
              "type": "string",
              "pattern": "^(http://[^/]+/?)?$"
            },
            "env": {
              "$ref": "#/definitions/env"
            },
            "extraEnv": {
              "$ref": "#/definitions/objects"
            },
            "extraVolumeMounts": {
              "$ref": "#/definitions/objects"
            },
            "extraVolumes": {
              "$ref": "#/definitions/objects"
            },
            "extraContainers": {
              "$ref": "#/definitions/objects"
            },
            "podAnnotations": {
              "$ref": "#/definitions/stringMap"
            },
            "podLabels": {
              "$ref": "#/definitions/podLabels"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            },
            "nodeSelector": {
              "$ref": "#/definitions/stringMap"
            },
            "tolerations": {
              "$ref": "#/definitions/objects"
            }
          }
        }
      }
    },
    "masqExempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "inviteTxnTimeoutSec": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 33,
      "maximum": 600
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cps": { "type": ["integer", "null"], "minimum": 1 },
            "holdSeconds": { "type": ["integer", "null"], "minimum": 1 },
            "ringSeconds": { "type": ["integer", "null"], "minimum": 0 },
            "invitesPerCall": { "type": ["number", "null"], "minimum": 2, "maximum": 100 }
          }
        },
        "callMarginPct": { "type": ["integer", "null"], "minimum": 0 },
        "emergencyPct": { "type": ["integer", "null"], "minimum": 1 },
        "txnMarginPct": { "type": ["integer", "null"], "minimum": 0 },
        "gateMarginPct": { "type": ["integer", "null"], "minimum": 1 },
        "txnSecondsPerCall": { "type": ["integer", "null"], "minimum": 0 },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseBytes": { "type": ["integer", "null"], "minimum": 0 },
            "answeredCallBytes": { "type": ["integer", "null"], "minimum": 0 },
            "ringingCallBytes": { "type": ["integer", "null"], "minimum": 0 },
            "replicaBytes": { "type": ["integer", "null"], "minimum": 0 },
            "txnBytes": { "type": ["integer", "null"], "minimum": 0 },
            "outboundConnections": { "type": ["integer", "null"], "minimum": 0 },
            "connectionBytes": { "type": ["integer", "null"], "minimum": 0 },
            "proxyBaseBytes": { "type": ["integer", "null"], "minimum": 0 },
            "memoEntryOverheadBytes": { "type": ["integer", "null"], "minimum": 0 },
            "slackPct": { "type": ["integer", "null"], "minimum": 0, "maximum": 99 }
          }
        }
      }
    }
  }
}
