# Names under a catalogue's namespace that the readers in deploy/ and the
# base dashboards (tooling/hakit/content/dashboards) spell but no catalogue
# declares, each scoped to the files it is allowed in; read by
# `metric-contract check` (see crates/metric-contract). `<path>: <name>`,
# the path relative to this directory, a file or a directory; a name here is
# checked nowhere in its scope, so keep each scope tight. An entry no reader
# in its scope uses any more is a finding. The series the HA tooling pushes
# are declared in tooling/hakit/content/metrics/, not here.

# Chaos event names: the files that name them.
docker/Dockerfile: limiter_netcut
../tooling/hakit/content/dashboards/call-limiter.json: limiter_kill
../tooling/hakit/content/dashboards/call-limiter.json: limiter_netcut
../tooling/hakit/content/dashboards/sipp-endurance-chaos.json: limiter_kill
../tooling/hakit/content/dashboards/sipp-endurance-chaos.json: limiter_netcut

# Prose shorthand for b2bua_active_calls, jemalloc_resident_bytes and
# process_resident_memory_bytes.
../tooling/hakit/content/dashboards/sipp-endurance-chaos.json: b2bua_active
../tooling/hakit/content/dashboards/jemalloc-allocator.json: jemalloc_resident
../tooling/hakit/content/dashboards/jemalloc-allocator.json: process_resident

# SIPp's -trace_err and -trace_stat options and the files they name.
helm/kind-lab.sh: trace_err
k8s/sipp/: trace_*

# Identifiers of the HA tooling runner (tooling/hakit/src: fields, functions,
# row keys, SIPp options), read as a reader for its own queries.
../tooling/hakit/src/: cdr_all
../tooling/hakit/src/: cdr_check
../tooling/hakit/src/: cdr_consumed_query
../tooling/hakit/src/: cdr_count
../tooling/hakit/src/: cdr_dropped
../tooling/hakit/src/: cdr_firings
../tooling/hakit/src/: cdr_found
../tooling/hakit/src/: cdr_impacts
../tooling/hakit/src/: cdr_impacts_of
../tooling/hakit/src/: cdr_in_flight_ms
../tooling/hakit/src/: cdr_in_flight_s
../tooling/hakit/src/: cdr_join
../tooling/hakit/src/: cdr_required
../tooling/hakit/src/: cdr_mismatch
../tooling/hakit/src/: cdr_ms
../tooling/hakit/src/: cdr_unaccounted
../tooling/hakit/src/: cdr_unread_query
../tooling/hakit/src/: cdr_written
../tooling/hakit/src/: cdr_written_query
../tooling/hakit/src/: sip_target
../tooling/hakit/src/: trace_err
../tooling/hakit/src/: trace_logs
../tooling/hakit/src/: trace_stat

# Labels the scrape adds to every series.
label:pod
label:namespace
label:job
label:instance
label:container
label:node
