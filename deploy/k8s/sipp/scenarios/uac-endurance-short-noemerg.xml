<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  Endurance background "short-hold" UAC — NON-EMERGENCY half of the short
  stream (role=short_ne). Identical to uac-endurance-short.xml (the EMERGENCY
  half, role=short_em) EXCEPT:

    * NO `Resource-Priority` header. The emergency sibling carries
      `Resource-Priority: esnet.0`, which `sip_message::is_emergency_request`
      recognises and the B2BUA's panic-ELU and CPS bucket rungs admit. This
      stream has no such marker, so it is the traffic the admission ladder
      sheds first (503 with Retry-After) when a worker is loaded — exactly the "new non-emergency calls may be rejected"
      behaviour the cpu_starve overload experiment asserts.

    * It TOLERATES an overload reject. Every admission rung answers the new
      call 503 with Retry-After; the call ACKs it, counts it on GenericCounter1
      and ends cleanly (the shed block below), so a shed call is NOT a SIPp
      failure. The SHED is measured SUT-side on
      `b2bua_new_calls_total{outcome="rejected"}` — the gate wants to see
      non-emergency calls rejected without that reading as breakage.

  A call that is ADMITTED runs the normal INVITE / 200 / ACK / 30s hold / BYE so
  established (in-dialog) short calls span the overload window and prove they are
  NOT impacted. The hold answers in-dialog OPTIONS (RFC 3261 §11), same as the
  emergency sibling; its 30000ms is hardcoded in the first hold recv's timeout
  and the `hold_ms` assign (sipp does not expand [$var] in attributes).
-->
<scenario name="K8s UAC endurance short-hold NON-emergency — INVITE / 200|reject / hold / BYE">

  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      X-Api-Call: {"destination":{"host":"[field0]","port":5060}}
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: K8s endurance short-hold non-emergency
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <recv response="503" optional="true" next="shed">
    <action>
      <ereg regexp="[0-9]+" search_in="hdr" header="Retry-After:" check_it="true" assign_to="retry_after"/>
    </action>
  </recv>
  <recv response="200" rtd="true" rrs="true"/>

  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <!-- The hold lasts hold_ms from the ACK and answers every in-dialog OPTIONS
       (RFC 3261 section 11). The first wait covers the whole hold; after an
       answered OPTIONS the rest runs off the clock in 1 s steps, so a probe
       ends the call at most 1 s late and never restarts the hold. `hold_ms`
       and the first timeout are one value.
       The answer sits after the step loop: a step that `_unexp.main` resumes
       re-enters through the deadline check, never through a second answer. -->
  <nop>
    <action>
      <assign assign_to="hold_ms" value="30000"/>
      <gettimeofday assign_to="hold_t0_s,hold_t0_us"/>
    </action>
  </nop>
  <recv request="OPTIONS" crlf="true" timeout="30000" ontimeout="hold_done" next="hold_options"/>
  <label id="hold_left"/>
  <nop>
    <action>
      <gettimeofday assign_to="hold_s,hold_us"/>
      <subtract assign_to="hold_s" variable="hold_t0_s"/>
      <multiply assign_to="hold_s" value="1000"/>
      <subtract assign_to="hold_us" variable="hold_t0_us"/>
      <divide assign_to="hold_us" value="1000"/>
      <add assign_to="hold_s" variable="hold_us"/>
      <test assign_to="hold_over" variable="hold_s" compare="greater_than_equal" variable2="hold_ms"/>
    </action>
  </nop>
  <nop test="hold_over" next="hold_done"/>
  <recv request="OPTIONS" crlf="true" timeout="1000" ontimeout="hold_left"/>
  <label id="hold_options"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
  </send>
  <nop next="hold_left"/>
  <label id="hold_done"/>

  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <!-- An in-dialog OPTIONS crossing the BYE is answered 200 once the BYE
       completes: the dialog stands until the BYE's final response (RFC 3261
       section 15.1.1), and SIPp sends nothing while its BYE is retransmitting.
       The OPTIONS is captured without leaving the wait, so the BYE's 200 that
       follows it on the wire still finds the call on its recv. The capture
       takes the first run of adjacent Via (or v:) rows and of Record-Route
       rows, and From / To / CSeq by their full names, in any case. -->
  <label id="options_wait1"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="options_wait1">
    <action>
      <ereg regexp="[[:cntrl:]](([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_via_row,opt_via"/>
      <ereg regexp="[[:cntrl:]]([Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+[Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_rr_row,opt_rr"/>
      <ereg regexp=".*" search_in="hdr" header="From:" start_line="true" case_indep="true" assign_to="opt_from"/>
      <ereg regexp=".*" search_in="hdr" header="To:" start_line="true" case_indep="true" assign_to="opt_to"/>
      <ereg regexp=".*" search_in="hdr" header="CSeq:" start_line="true" case_indep="true" assign_to="opt_cseq"/>
      <assign assign_to="options_due" value="1"/>
    </action>
  </recv>
  <recv response="200" crlf="true"/>
  <send condexec="options_due">
    <![CDATA[
      SIP/2.0 200 OK
      [$opt_via]
      [$opt_rr]
      From:[$opt_from]
      To:[$opt_to]
      Call-ID: [call_id]
      CSeq:[$opt_cseq]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
    <action>
      <assign assign_to="options_due" value="0"/>
    </action>
  </send>

  <nop next="end"/>

  <!-- The admission shed: the SUT refused the new call with a 503 carrying
       Retry-After, as every admission rung does. The ACK takes the INVITE's branch
       (RFC 3261 section 17.1.1.3; [branch-18] is this send's own index) and the
       call ends counted on GenericCounter1. A 503 without Retry-After fails the
       call (FailedRegexpHdrNotFound); it is still ACKed here. -->
  <label id="shed"/>
  <send>
    <![CDATA[
      ACK sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch-18];rport
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
    <action>
      <strcmp assign_to="retry_after_cmp" variable="retry_after" value=""/>
      <test assign_to="shed_counted" variable="retry_after_cmp" compare="not_equal" value="0"/>
    </action>
  </send>
  <nop test="shed_counted" next="shed_counted"/>
  <nop next="end"/>
  <label id="shed_counted"/>
  <nop counter="1" next="end"/>

  <!-- SIPp runs a call one step per loop turn and reads its socket in between:
       a request that lands while the call stands on a send or a nop (the step
       after a hold timeout), or that no recv at hand expects (a BYE mid-hold),
       comes here. An OPTIONS is answered and the call resumes the step it stood
       on. A BYE is answered and the call ends failed, as test_doesnt_match:
       SIPp's own unexpected-BYE handling (200, unexpected_msg) does not run
       while this hook exists. Anything else is unexpected here too and fails
       the call. -->
  <label id="_unexp.main"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="unexp_options"/>
  <recv request="BYE" crlf="true"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
  </send>
  <nop next="end">
    <action>
      <assign assign_to="sut_ended_call" value="1"/>
      <test variable="sut_ended_call" compare="equal" value="0" check_it="true"/>
    </action>
  </nop>
  <label id="unexp_options"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
  </send>
  <nop>
    <action>
      <jump variable="_unexp.retaddr"/>
      <assign assign_to="_unexp.retaddr" value="0"/>
    </action>
  </nop>
  <label id="end"/>

  <Reference variables="opt_via_row,opt_rr_row"/>
  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200"/>
  <CallLengthRepartition value="100, 1000, 10000, 30000, 60000, 120000"/>
</scenario>
