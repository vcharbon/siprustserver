<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  Re-INVITE UAC for endurance: INVITE → 200 → ACK → re-INVITE@+60s → re-INVITE@+120s → BYE.

  Purpose: prove the IN-DIALOG re-INVITE transaction (INVITE/200/ACK) survives a
  worker reboot, INCLUDING the split where the FIRST re-INVITE is served by the
  takeover BACKUP and the SECOND by the reclaimed NOMINAL (or the other way
  around). The two re-INVITEs are spaced 60 s apart so they straddle the
  ~minutes-long takeover → reclaim → self-release transition (ADR-0014); with
  continuous call creation, a steady fraction of calls have their two re-INVITEs
  land on different workers across any given reboot.

  Complements uac-long-options.xml (which exercises the in-dialog OPTIONS
  keepalive path): together they prove BOTH in-dialog request classes route
  correctly across failover. Each 60s hold answers any in-dialog OPTIONS
  (RFC 3261 §11): a rebooted worker's reclaim re-spreads restored dialogs'
  300s keepalives EARLIER, so a probe can land mid-hold even in a ~2 min
  call; the hold keeps its 60 s from the ACK whether or not one arrives.

  CSeq increments per in-dialog transaction (RFC 3261 §12.2.1.1):
    INVITE=1, re-INVITE=2, re-INVITE=3, BYE=4 — each ACK reuses its INVITE's CSeq.
  [routes] expands to the proxy's Record-Route (stickiness cookie) captured via
  rrs="true" on the initial 200, so every in-dialog request traverses the proxy;
  [next_url] is the peer's remote target (the B2BUA a-leg Contact). The B2BUA
  relays each re-INVITE onto the b-leg, so the B-leg UAS (uas-basic.xml) answers
  it — see the re-INVITE branch in that scenario's wait loop.
-->
<scenario name="K8s UAC re-INVITE — INVITE/ACK + 2 in-dialog re-INVITEs + BYE">

  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      X-Api-Call: {"destination":{"host":"[field0]","port":5060}}
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Subject: K8s endurance re-INVITE call
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <!-- An admission rejection of the initial INVITE (503 overload shed, 480/486
       admission control) ends the call cleanly at `rejected`, which ACKs the final;
       and the SUT's shed counters carry the decision, not this stream's
       unexpected_msg. -->
  <recv response="503" optional="true" next="rejected"/>
  <recv response="480" optional="true" next="rejected"/>
  <recv response="486" optional="true" next="rejected"/>
  <recv response="200" rtd="true" rrs="true"/>

  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <!-- ===== re-INVITE #1 at +60 s (likely served by one worker) ===== -->
  <!-- The hold lasts hold_ms from the ACK and answers every in-dialog OPTIONS
       (RFC 3261 section 11). The first wait covers the whole hold; after an
       answered OPTIONS the rest runs off the clock in 1 s steps, so a probe
       ends the call at most 1 s late and never restarts the hold. `hold_ms`
       and the first timeout are one value.
       The answer sits after the step loop: a step that `_unexp.main` resumes
       re-enters through the deadline check, never through a second answer. -->
  <nop>
    <action>
      <assign assign_to="hold_ms" value="60000"/>
      <gettimeofday assign_to="hold_t0_s,hold_t0_us"/>
    </action>
  </nop>
  <recv request="OPTIONS" crlf="true" timeout="60000" ontimeout="hold1_done" next="hold1_options"/>
  <label id="hold1_left"/>
  <nop>
    <action>
      <gettimeofday assign_to="hold_s,hold_us"/>
      <subtract assign_to="hold_s" variable="hold_t0_s"/>
      <multiply assign_to="hold_s" value="1000"/>
      <subtract assign_to="hold_us" variable="hold_t0_us"/>
      <divide assign_to="hold_us" value="1000"/>
      <add assign_to="hold_s" variable="hold_us"/>
      <test assign_to="hold_over" variable="hold_s" compare="greater_than_equal" variable2="hold_ms"/>
    </action>
  </nop>
  <nop test="hold_over" next="hold1_done"/>
  <recv request="OPTIONS" crlf="true" timeout="1000" ontimeout="hold1_left"/>
  <label id="hold1_options"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
  </send>
  <nop next="hold1_left"/>
  <label id="hold1_done"/>
  <send retrans="500">
    <![CDATA[
      INVITE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 INVITE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687638 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>
  <!-- An in-dialog OPTIONS crossing the re-INVITE is captured and answered 200
       after the ACK: SIPp sends nothing while its INVITE is retransmitting. -->
  <label id="options_wait1"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="options_wait1">
    <action>
      <ereg regexp="[[:cntrl:]](([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_via_row,opt_via"/>
      <ereg regexp="[[:cntrl:]]([Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+[Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_rr_row,opt_rr"/>
      <ereg regexp=".*" search_in="hdr" header="From:" start_line="true" case_indep="true" assign_to="opt_from"/>
      <ereg regexp=".*" search_in="hdr" header="To:" start_line="true" case_indep="true" assign_to="opt_to"/>
      <ereg regexp=".*" search_in="hdr" header="CSeq:" start_line="true" case_indep="true" assign_to="opt_cseq"/>
      <assign assign_to="options_due" value="1"/>
    </action>
  </recv>
  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <recv response="200" rtd="true" crlf="true"/>
  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 ACK
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>
  <send condexec="options_due">
    <![CDATA[
      SIP/2.0 200 OK
      [$opt_via]
      [$opt_rr]
      From:[$opt_from]
      To:[$opt_to]
      Call-ID: [call_id]
      CSeq:[$opt_cseq]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
    <action>
      <assign assign_to="options_due" value="0"/>
    </action>
  </send>

  <!-- ===== re-INVITE #2 at +120 s (may be served by the OTHER worker post-failover) ===== -->
  <!-- The hold lasts hold_ms from the ACK and answers every in-dialog OPTIONS
       (RFC 3261 section 11). The first wait covers the whole hold; after an
       answered OPTIONS the rest runs off the clock in 1 s steps, so a probe
       ends the call at most 1 s late and never restarts the hold. `hold_ms`
       and the first timeout are one value.
       The answer sits after the step loop: a step that `_unexp.main` resumes
       re-enters through the deadline check, never through a second answer. -->
  <nop>
    <action>
      <assign assign_to="hold_ms" value="60000"/>
      <gettimeofday assign_to="hold_t0_s,hold_t0_us"/>
    </action>
  </nop>
  <recv request="OPTIONS" crlf="true" timeout="60000" ontimeout="hold2_done" next="hold2_options"/>
  <label id="hold2_left"/>
  <nop>
    <action>
      <gettimeofday assign_to="hold_s,hold_us"/>
      <subtract assign_to="hold_s" variable="hold_t0_s"/>
      <multiply assign_to="hold_s" value="1000"/>
      <subtract assign_to="hold_us" variable="hold_t0_us"/>
      <divide assign_to="hold_us" value="1000"/>
      <add assign_to="hold_s" variable="hold_us"/>
      <test assign_to="hold_over" variable="hold_s" compare="greater_than_equal" variable2="hold_ms"/>
    </action>
  </nop>
  <nop test="hold_over" next="hold2_done"/>
  <recv request="OPTIONS" crlf="true" timeout="1000" ontimeout="hold2_left"/>
  <label id="hold2_options"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
  </send>
  <nop next="hold2_left"/>
  <label id="hold2_done"/>
  <send retrans="500">
    <![CDATA[
      INVITE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 INVITE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687639 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>
  <!-- An in-dialog OPTIONS crossing the re-INVITE is captured and answered 200
       after the ACK: SIPp sends nothing while its INVITE is retransmitting. -->
  <label id="options_wait2"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="options_wait2">
    <action>
      <ereg regexp="[[:cntrl:]](([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_via_row,opt_via"/>
      <ereg regexp="[[:cntrl:]]([Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+[Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_rr_row,opt_rr"/>
      <ereg regexp=".*" search_in="hdr" header="From:" start_line="true" case_indep="true" assign_to="opt_from"/>
      <ereg regexp=".*" search_in="hdr" header="To:" start_line="true" case_indep="true" assign_to="opt_to"/>
      <ereg regexp=".*" search_in="hdr" header="CSeq:" start_line="true" case_indep="true" assign_to="opt_cseq"/>
      <assign assign_to="options_due" value="1"/>
    </action>
  </recv>
  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <recv response="200" rtd="true" crlf="true"/>
  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 ACK
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>
  <send condexec="options_due">
    <![CDATA[
      SIP/2.0 200 OK
      [$opt_via]
      [$opt_rr]
      From:[$opt_from]
      To:[$opt_to]
      Call-ID: [call_id]
      CSeq:[$opt_cseq]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
    <action>
      <assign assign_to="options_due" value="0"/>
    </action>
  </send>

  <!-- ===== teardown ===== -->
  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      [routes]
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 4 BYE
      Contact: sip:sipp@[local_ip]:[local_port]
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <!-- An in-dialog OPTIONS crossing the BYE is answered 200 once the BYE
       completes: the dialog stands until the BYE's final response (RFC 3261
       section 15.1.1), and SIPp sends nothing while its BYE is retransmitting.
       The OPTIONS is captured without leaving the wait, so the BYE's 200 that
       follows it on the wire still finds the call on its recv. The capture
       takes the first run of adjacent Via (or v:) rows and of Record-Route
       rows, and From / To / CSeq by their full names, in any case. -->
  <label id="options_wait3"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="options_wait3">
    <action>
      <ereg regexp="[[:cntrl:]](([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+([Vv][Ii][Aa]|[Vv])[[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_via_row,opt_via"/>
      <ereg regexp="[[:cntrl:]]([Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*([[:cntrl:]]+[Rr][Ee][Cc][Oo][Rr][Dd]-[Rr][Oo][Uu][Tt][Ee][[:blank:]]*:[^[:cntrl:]]*)*)" search_in="msg" assign_to="opt_rr_row,opt_rr"/>
      <ereg regexp=".*" search_in="hdr" header="From:" start_line="true" case_indep="true" assign_to="opt_from"/>
      <ereg regexp=".*" search_in="hdr" header="To:" start_line="true" case_indep="true" assign_to="opt_to"/>
      <ereg regexp=".*" search_in="hdr" header="CSeq:" start_line="true" case_indep="true" assign_to="opt_cseq"/>
      <assign assign_to="options_due" value="1"/>
    </action>
  </recv>
  <recv response="200" crlf="true"/>
  <send condexec="options_due">
    <![CDATA[
      SIP/2.0 200 OK
      [$opt_via]
      [$opt_rr]
      From:[$opt_from]
      To:[$opt_to]
      Call-ID: [call_id]
      CSeq:[$opt_cseq]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
    <action>
      <assign assign_to="options_due" value="0"/>
    </action>
  </send>

  <nop next="rejected_done"/>

  <!-- A non-2xx final of the initial INVITE that an optional recv above takes
       jumps to `rejected`. SIPp sends no ACK for such a final, so the call ACKs
       it on the INVITE's branch (RFC 3261 section 17.1.1.3; [branch-41] is
       this send's own index). The admitted path skips the ACK. Either way the
       call ends Successful. -->
  <label id="rejected"/>
  <send>
    <![CDATA[
      ACK sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch-41];rport
      From: sipp <sip:sipp@[local_ip]:[local_port]>;tag=[pid]SIPpTag00[call_number]
      To: sut <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>
  <label id="rejected_done"/>

  <nop next="end"/>

  <!-- SIPp runs a call one step per loop turn and reads its socket in between:
       a request that lands while the call stands on a send or a nop (the step
       after a hold timeout), or that no recv at hand expects (a BYE mid-hold),
       comes here. An OPTIONS is answered and the call resumes the step it stood
       on. A BYE is answered and the call ends failed, as test_doesnt_match:
       SIPp's own unexpected-BYE handling (200, unexpected_msg) does not run
       while this hook exists. Anything else is unexpected here too and fails
       the call. -->
  <label id="_unexp.main"/>
  <recv request="OPTIONS" optional="true" crlf="true" next="unexp_options"/>
  <recv request="BYE" crlf="true"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
  </send>
  <nop next="end">
    <action>
      <assign assign_to="sut_ended_call" value="1"/>
      <test variable="sut_ended_call" compare="equal" value="0" check_it="true"/>
    </action>
  </nop>
  <label id="unexp_options"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: sip:sipp@[local_ip]:[local_port]
      Content-Length: 0
    ]]>
  </send>
  <nop>
    <action>
      <jump variable="_unexp.retaddr"/>
      <assign assign_to="_unexp.retaddr" value="0"/>
    </action>
  </nop>
  <label id="end"/>

  <Reference variables="opt_via_row,opt_rr_row"/>
  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000, 60000, 120000"/>
</scenario>
