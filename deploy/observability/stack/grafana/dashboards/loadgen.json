{
  "uid": "loadgen-perf",
  "title": "Loadgen \u2014 Rust functional-perf (SIPp substitute)",
  "tags": [
    "sip",
    "loadgen",
    "endurance"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Chaos window",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "enable": true,
        "iconColor": "semi-dark-orange",
        "expr": "sip_chaos_window == 1",
        "titleFormat": "chaos: {{type}}",
        "tagKeys": "type",
        "step": "10s"
      },
      {
        "name": "UAS crash (involuntary)",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "sip_chaos_window{type=\"uas_crash\"} == 1",
        "titleFormat": "INVOLUNTARY UAS crash (test infra)",
        "step": "10s"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Loadgen \u2014 Rust functional-perf stream (in parallel with SIPp)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "In-flight calls",
      "description": "Live concurrent calls summed over every loadgen. At a steady rate in-flight \u2248 offered cps \u00d7 mean call hold (Little's law): a refused call lasts milliseconds, so in-flight falls as refusals rise at constant cps.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum(loadgen_inflight)",
          "refId": "A",
          "legendFormat": "inflight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Offered rate (cps, 1m)",
      "description": "Calls/s the generator is starting (target ~20).",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_started_total[1m]))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Mean call hold (s, 1m)",
      "description": "Mean completed-call duration from the end-to-end histogram (sum / count). Dominated by the scripted ring and talk; with the offered rate it explains in-flight.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_e2e_latency_seconds_sum[1m])) / sum(rate(loadgen_e2e_latency_seconds_count[1m]))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Success ratio (admitted, 5m)",
      "description": "ok over the completed calls the SUT admitted: completed minus the shapes' expected rejects (class expected_reject) minus the 503 refusals (shown apart). No admitted call in the window reads as no data.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "(sum(increase(loadgen_calls_total{class=\"ok\"}[5m])) or vector(0)) / (sum(increase(loadgen_calls_total[5m])) - (sum(increase(loadgen_calls_total{class=\"expected_reject\"}[5m])) or vector(0)) - (sum(increase(loadgen_calls_total{class=\"status_503\"}[5m])) or vector(0)) > 0)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Refused 503 ratio (5m)",
      "description": "Completed calls refused with 503 over all completed calls. A ramp past capacity refuses on purpose; a 503 below capacity is a defect. No completed call in the window reads as no data.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "(sum(increase(loadgen_calls_total{class=\"status_503\"}[5m])) or vector(0)) / (sum(increase(loadgen_calls_total[5m])) > 0)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Shed (max-in-flight)",
      "description": "Calls dropped at the max-in-flight cap (offered load the generator itself shed \u2014 raise --max-in-flight if non-zero).",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum(loadgen_shed_total)",
          "refId": "A",
          "legendFormat": "shed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Process RSS (memory canary)",
      "description": "Load generator resident memory. Watch this with full recording on \u2014 a steady climb at flat in-flight means recording-memory growth.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "max(loadgen_process_resident_memory_bytes)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Mux registry (leak canary)",
      "description": "Live demux entries summed over every loadgen; tracks in-flight, a steady rise above it is a leak.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum(loadgen_mux_registry_size)",
          "refId": "A",
          "legendFormat": "registry"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Completed calls/s by result class",
      "description": "Completion rate split by result class (ok / status_503 / timeout / unexpected / panic / rfc_audit_fail / \u2026). expected_reject is the shape's declared reject (an outcome, not a failure); status_503 a SUT refusal.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum by (class)(rate(loadgen_calls_total[1m])) > 0",
          "refId": "A",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Completed calls/s by scenario",
      "description": "Completion rate split by scenario (basic_call / reinvite / long_call / refer).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum by (scenario)(rate(loadgen_calls_total[1m]))",
          "refId": "A",
          "legendFormat": "{{scenario}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "SIP round trip by exchange, p50 / p99 (s)",
      "description": "Windowed quantiles of loadgen_rtt_seconds over every scenario: request first sent \u2192 first 100 / first 18x (INVITE) / final (non-INVITE), and UAS 2xx first sent \u2192 ACK. No scripted timer is inside these exchanges, so they measure the SUT.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, exchange)(rate(loadgen_rtt_seconds_bucket[1m])))",
          "refId": "A",
          "legendFormat": "{{exchange}} p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, exchange)(rate(loadgen_rtt_seconds_bucket[1m])))",
          "refId": "B",
          "legendFormat": "{{exchange}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "SIP round trip p90 by scenario \u00d7 exchange (s)",
      "description": "Windowed p90 of loadgen_rtt_seconds per scenario and exchange (1m rate).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum by (le, scenario, exchange)(rate(loadgen_rtt_seconds_bucket[1m])))",
          "refId": "A",
          "legendFormat": "{{scenario}} {{exchange}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Process RSS over time (memory)",
      "description": "Load generator RSS over the run. Cross-reference chaos windows (annotations). Full recording keeps per-call buffers; a climb decoupled from in-flight is a recording-memory issue \u2014 lower --sample-cap or --background-record-every.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "max(loadgen_process_resident_memory_bytes)",
          "refId": "A",
          "legendFormat": "rss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Mux demux & orphans",
      "description": "Demux health: registry_size tracks inflight; orphans split by reason AND CSeq method (stray BYE vs OPTIONS = the post-failover straggler breakdown for triage). unknown_token>0 would mean a relay failure.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum(loadgen_mux_registry_size)",
          "refId": "A",
          "legendFormat": "registry_size"
        },
        {
          "expr": "sum(loadgen_inflight)",
          "refId": "B",
          "legendFormat": "inflight"
        },
        {
          "expr": "sum by (reason,method)(loadgen_mux_orphan_total) > 0",
          "refId": "C",
          "legendFormat": "orphan {{reason}}/{{method}}"
        },
        {
          "expr": "sum(loadgen_mux_inbox_drop_total)",
          "refId": "D",
          "legendFormat": "inbox_drop"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
